# ビルド成果物
dist/
storybook-static/

# ロックファイル。pnpm が管理する形式なので Prettier に触らせない
pnpm-lock.yaml

# 生成物（pnpm generate:tokens が出力）。
# 整形しても次の生成で上書きされるため対象外にする。
src/styles/tokens.css
src/styles/alias-ibuki.css
src/styles/alias-shadcn.css

# shadcn/ui から取り込んだコンポーネント。
#
# 上流の書式（ダブルクォート・セミコロンなし）のまま保つ。整形すると
# `shadcn add --diff` の差分が書式ノイズで埋まり、上流の実際の変更が
# 読めなくなるため。Kedama トークンでの再スタイルによる差分だけが
# 見えている状態を保つ。
src/components/ui/

# @kedama-design/core の写し。
#
# core/ui/ は登記議事録つくるさんの src/ui/ と同じ書式のまま保つ（段3で写し戻すとき、
# 登記の文字列ベースのテストがそのまま通るように）。core/guidelines/ はガイドラインの
# 写しで、直したファイル以外は元と同じ sha256 であることを core のテストが確かめる。
# core のほかのファイル（test・examples・README・docs）は prettier に従う。
core/ui/
core/guidelines/
