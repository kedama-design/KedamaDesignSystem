{
  "name": "@kedama-design/core",
  "version": "0.2.0",
  "description": "Kedama の共有の値（--ui-* の CSS 変数）と、仕組みに依存しない部品（素の CSS と ESM の JavaScript）。React・Tailwind に依存しない",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.css": "./ui/tokens.css",
    "./base.css": "./ui/base.css",
    "./components.css": "./ui/components.css",
    "./shell.css": "./ui/shell.css",
    "./motion.js": "./ui/motion.js",
    "./toast.js": "./ui/toast.js",
    "./drawer.js": "./ui/drawer.js",
    "./dateinput.js": "./ui/dateinput.js",
    "./icons.js": "./ui/icons.js",
    "./shell.js": "./ui/shell.js",
    "./tokens.json": "./guidelines/tokens/tokens.json",
    "./icons/publish-failed.svg": "./guidelines/icons/publish-failed.svg",
    "./icons/publish-published.svg": "./guidelines/icons/publish-published.svg",
    "./icons/publish-unpublished.svg": "./guidelines/icons/publish-unpublished.svg",
    "./icons/status-approved.svg": "./guidelines/icons/status-approved.svg",
    "./icons/status-client-review.svg": "./guidelines/icons/status-client-review.svg",
    "./icons/status-draft.svg": "./guidelines/icons/status-draft.svg",
    "./icons/status-idea.svg": "./guidelines/icons/status-idea.svg",
    "./icons/status-internal-review.svg": "./guidelines/icons/status-internal-review.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "ui/",
    "guidelines/tokens/tokens.json",
    "guidelines/icons/",
    "!guidelines/README.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "verify:pack": "node scripts/verify-pack.mjs"
  }
}
